package com.example.quizapp

import android.content.res.ColorStateList
import android.graphics.Color
import android.os.Bundle
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import com.example.quizapp.databinding.ActivityMainBinding

class QuizMath : AppCompatActivity() {

    private lateinit var binding: ActivityMainBinding

    private val questions = arrayOf(
        "What shape is this?",
        "What shape is this?",
        "What shape is this?"
    )

    private val options = arrayOf(
        arrayOf("Triangle", "Rectangle", "Square", "Circle"),
        arrayOf("Circle", "Triangle", "Rectangle", "Square"),
        arrayOf("Square", "Circle", "Triangle", "Rectangle")
    )

    private val photos = arrayOf(
        R.drawable.triangle,
        R.drawable.circle,
        R.drawable.square
    )

    private val correctAnswers = arrayOf(0, 0, 0)

    private var currentQuestionIndex = 0
    private var score = 0

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        binding = ActivityMainBinding.inflate(layoutInflater)
        setContentView(binding.root)

        displayQuestion()

        binding.option1Button.setOnClickListener { checkAnswer(0) }
        binding.option2Button.setOnClickListener { checkAnswer(1) }
        binding.option3Button.setOnClickListener { checkAnswer(2) }
        binding.option4Button.setOnClickListener { checkAnswer(3) }
    }

    private fun displayQuestion() {
        binding.questionText.text = questions[currentQuestionIndex]
        binding.option1Button.text = options[currentQuestionIndex][0]
        binding.option2Button.text = options[currentQuestionIndex][1]
        binding.option3Button.text = options[currentQuestionIndex][2]
        binding.option4Button.text = options[currentQuestionIndex][3]

        binding.imageView.setImageResource(photos[currentQuestionIndex])
        binding.progressText.text =
            "${currentQuestionIndex + 1}/${questions.size}"

        resetButtonColors()
        setOptionButtonsEnabled(true)
    }

    private fun checkAnswer(selectedAnswerIndex: Int) {
        setOptionButtonsEnabled(false)

        val correctAnswerIndex = correctAnswers[currentQuestionIndex]

        if (selectedAnswerIndex == correctAnswerIndex) {
            score++
            setGreen(selectedAnswerIndex)
        } else {
            setRed(selectedAnswerIndex)
            setGreen(correctAnswerIndex)
        }

        if (currentQuestionIndex < questions.size - 1) {
            currentQuestionIndex++
            binding.root.postDelayed({
                displayQuestion()
            }, 1000)
        } else {
            showResults()
        }
    }

    private fun setGreen(index: Int) {
        val green = ColorStateList.valueOf(Color.parseColor("#61E547"))
        getButton(index).backgroundTintList = green
    }

    private fun setRed(index: Int) {
        val red = ColorStateList.valueOf(Color.parseColor("#FF4A4C"))
        getButton(index).backgroundTintList = red
    }

    private fun resetButtonColors() {
        val defaultColor =
            ColorStateList.valueOf(Color.parseColor("#AEB8FE"))
        for (i in 0..3) getButton(i).backgroundTintList = defaultColor
    }

    private fun setOptionButtonsEnabled(enabled: Boolean) {
        for (i in 0..3) getButton(i).isEnabled = enabled
    }

    private fun getButton(index: Int) = when (index) {
        0 -> binding.option1Button
        1 -> binding.option2Button
        2 -> binding.option3Button
        else -> binding.option4Button
    }

    private fun showResults() {
        Toast.makeText(
            this,
            "Quiz Finished! Score: $score / ${questions.size}",
            Toast.LENGTH_LONG
        ).show()
    }
}
