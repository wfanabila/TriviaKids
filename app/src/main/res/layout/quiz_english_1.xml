<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/background"
    tools:context=".QuizEnglish">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="50dp">

        <ImageView
            android:id="@+id/close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/close_button"/>

        <TextView
            android:id="@+id/editProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENGLISH"
            android:textSize="15sp"
            android:textColor="#000000"
            android:background="@drawable/edit_profile_label_bg"
            android:padding="8dp"
            android:gravity="center"
            android:layout_centerInParent="true"/>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp">
        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="350dp"
        android:layout_height="420dp"
        android:layout_marginTop="15dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="15dp">

        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="40dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp">

            <androidx.cardview.widget.CardView
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                app:cardBackgroundColor="@color/buttonPurple"
                app:cardCornerRadius="30dp">

                <TextView
                    android:id="@+id/totalQuestion"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="1/3"
                    android:textColor="@color/black"
                    android:textSize="19sp" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/timer"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="130dp"
                app:cardBackgroundColor="@color/buttonPurple"
                app:cardCornerRadius="30dp">

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/black"
                    android:textSize="19sp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/yellow"
            app:cardCornerRadius="30dp">

            <TextView
                android:id="@+id/question_text"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="Question"
                android:textColor="@color/black"
                android:textSize="24sp" />

        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="160dp"
            android:layout_gravity="center_horizontal">
        </ImageView>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="380dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/option_1_button"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="140dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/lightPurple"
            android:text="Option 1"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:elevation="10dp"
            android:stateListAnimator="@null"
            android:outlineProvider="background"
            app:cornerRadius="20dp"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/option_2_button"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="140dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/lightPurple"
            android:text="Option 2"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:elevation="10dp"
            android:stateListAnimator="@null"
            android:outlineProvider="background"
            app:cornerRadius="20dp"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp" />
    </LinearLayout>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="380dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/option_3_button"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="140dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/lightPurple"
            android:text="Option 3"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:elevation="10dp"
            android:stateListAnimator="@null"
            android:outlineProvider="background"
            app:cornerRadius="20dp"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/option_4_button"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="60dp"
            android:layout_height="140dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/lightPurple"
            android:text="Option 4"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:elevation="10dp"
            android:stateListAnimator="@null"
            android:outlineProvider="background"
            app:cornerRadius="20dp"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp" />
    </LinearLayout>

</LinearLayout>

