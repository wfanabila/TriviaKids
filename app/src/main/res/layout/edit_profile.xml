<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/background"
    tools:context=".EditProfile">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp">

        <ImageView
            android:id="@+id/close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/close_button"/>

        <TextView
            android:id="@+id/editProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_profile_page"
            android:textSize="15sp"
            android:textColor="#000000"
            android:background="@drawable/edit_profile_label_bg"
            android:padding="8dp"
            android:gravity="center"
            android:layout_centerInParent="true"/>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp">
        </androidx.cardview.widget.CardView>

    </RelativeLayout>


    <androidx.cardview.widget.CardView
        android:layout_width="347dp"
        android:layout_height="614dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="15dp">

        <FrameLayout
            android:layout_width="155dp"
            android:layout_height="155dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                app:cardCornerRadius="75dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/greenCorner"
                app:strokeWidth="4dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/pfp_ava"
                    android:contentDescription="@string/profile_picture"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/button_edit_avatar"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/plus_icon"
                android:contentDescription="@string/edit_avatar"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/username_txt"
            android:layout_width="149dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="215dp"
            android:labelFor="@id/username"
            android:paddingStart="23dp"
            android:paddingEnd="16dp"
            android:text="@string/username_label" />

        <EditText
            android:id="@+id/username"
            android:layout_width="310dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="235dp"
            android:autofillHints="username"
            android:background="@drawable/edit_text_rounded_corner"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/email_txt"
            android:layout_width="149dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="295dp"
            android:labelFor="@id/email"
            android:paddingStart="23dp"
            android:paddingEnd="16dp"
            android:text="@string/email_label" />

        <EditText
            android:id="@+id/email"
            android:layout_width="310dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="315dp"
            android:autofillHints="email"
            android:background="@drawable/edit_text_rounded_corner"
            android:ems="10"
            android:inputType="textEmailAddress"
            android:paddingStart="10dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/curr_pass_txt"
            android:layout_width="149dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="375dp"
            android:contentDescription="@string/current_password_label"
            android:labelFor="@id/curr_pass"
            android:paddingStart="23dp"
            android:paddingEnd="5dp"
            android:text="@string/currPass_label" />

        <EditText
            android:id="@+id/curr_pass"
            android:layout_width="310dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="395dp"
            android:autofillHints="currPass"
            android:background="@drawable/edit_text_rounded_corner"
            android:ems="10"
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/new_pass_txt"
            android:layout_width="149dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="455dp"
            android:contentDescription="@string/new_password_label"
            android:labelFor="@id/new_pass"
            android:paddingStart="23dp"
            android:paddingEnd="16dp"
            android:text="@string/newPass_label" />

        <EditText
            android:id="@+id/new_pass"
            android:layout_width="310dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="475dp"
            android:autofillHints="newPass"
            android:background="@drawable/edit_text_rounded_corner"
            android:ems="10"
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="545dp"
            android:layout_weight="1"
            android:backgroundTint="@color/buttonPurple"
            android:elevation="10dp"
            android:outlineProvider="background"
            android:stateListAnimator="@null"
            android:text="@string/save_change"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:cornerRadius="10dp" />

    </androidx.cardview.widget.CardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="350dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/buttonPurple">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:itemBackground="@android:color/transparent"
            app:itemIconSize="35dp"
            app:itemIconTint="@color/white"
            app:itemTextColor="@color/white"
            app:menu="@menu/bottom_nav" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
