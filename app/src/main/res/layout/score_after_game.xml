<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/background"
    tools:context=".EditProfile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:gravity="start|center_vertical">

        <ImageView
            android:id="@+id/closeButton"
            android:layout_width="21dp"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#424242" />

    </LinearLayout>


    <ImageView
        android:id="@+id/gameImage"
        android:layout_width="510dp"
        android:layout_height="480dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:layout_marginTop="70dp"
        android:background="@drawable/score_section" />

    <TextView
        android:id="@+id/text_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="-175dp"
        android:text="You Scored"
        android:textSize="15sp"
        android:textColor="#FF000000" />

    <TextView
        android:id="@+id/scoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="-3dp"
        android:textColor="#FF0000"
        android:text="90/100"
        android:textSize="40sp"

        android:textStyle="bold" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
        android:gravity="center"
    android:layout_marginTop="1dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finished at"
        android:textSize="15sp"
        android:textColor="#FF0000" />

    <Space
        android:layout_width="10dp"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/dialogQuizCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=": 02:00"
        android:textSize="15sp"
        android:textColor="#FF0000" />
</LinearLayout>

    <Button
        android:id="@+id/playAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="7dp"
        android:text="@string/play_again"
        android:textSize="15sp"
        android:textColor="#FF000000"
        android:background="?android:attr/selectableItemBackground"/>

    <Button
        android:id="@+id/save"
        android:layout_width="130dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="45dp"
        android:backgroundTint="@color/buttonPurple"
        android:elevation="10dp"
        android:outlineProvider="background"
        android:stateListAnimator="@null"
        android:text="@string/next_game"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:cornerRadius="20dp"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="350dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="140dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/buttonPurple">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:itemBackground="@android:color/transparent"
            app:itemIconSize="35dp"
            app:itemIconTint="@color/white"
            app:itemTextColor="@color/white"
            app:menu="@menu/bottom_nav" />
    </com.google.android.material.card.MaterialCardView>


</LinearLayout>
