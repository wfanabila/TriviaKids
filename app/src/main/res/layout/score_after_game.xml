<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/background"
    tools:context=".EditProfile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:gravity="start|center_vertical">

        <ImageView
            android:id="@+id/closeButton"
            android:layout_width="21dp"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#424242" />

    </LinearLayout>


    <ImageView
        android:id="@+id/gameImage"
        android:layout_width="510dp"
        android:layout_height="480dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:layout_marginTop="70dp"
        android:background="@drawable/score_section" />

    <TextView
        android:id="@+id/text_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="-160dp"
        android:text="You Scored"
        android:textSize="15sp"
        android:textColor="#FF000000" />

    <TextView
        android:id="@+id/scoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="-3dp"
        android:text="90/100"
        android:textSize="40sp"
        android:textColor="#FF0000"
        android:textStyle="bold" />

    <Button
        android:id="@+id/playAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="7dp"
        android:text="@string/play_again"
        android:textSize="15sp"
        android:textColor="#FF000000"
        android:background="?android:attr/selectableItemBackground"/>

    <Button
        android:id="@+id/save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="45dp"
        android:backgroundTint="@color/buttonPurple"
        android:elevation="10dp"
        android:outlineProvider="background"
        android:stateListAnimator="@null"
        android:text="@string/next_game"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:cornerRadius="10dp"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/nav_bar_corner"
        android:layout_marginTop="115dp"
        android:layout_gravity="bottom">

        <ImageButton
            android:id="@+id/score_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@null"
            android:contentDescription="@string/score"
            android:scaleType="fitCenter"
            android:layout_marginEnd="50dp"
            android:src="@drawable/score_icon" />

        <ImageButton
            android:id="@+id/home_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@null"
            android:contentDescription="@string/home"
            android:scaleType="fitCenter"
            android:layout_marginEnd="50dp"
            android:src="@drawable/home_icon" />

        <ImageButton
            android:id="@+id/profile_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@null"
            android:contentDescription="@string/profile"
            android:scaleType="fitCenter"
            android:src="@drawable/profile_icon" />

    </LinearLayout>

</LinearLayout>
